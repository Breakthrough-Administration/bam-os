rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // TEMPORARY TEST MODE: Allow all read and write access
    // This allows the app to function even if Email/Password Auth is disabled.
    match /{document=**} {
      allow read, write: if true;
    }

    // Role verification functions
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isManager() {
      return getUserRole() in ['practice_manager', 'compliance_officer', 'lead_clinician'];
    }

    function isClinician() {
      return getUserRole() in ['pbs_practitioner', 'lead_clinician'];
    }

    // Users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isManager());
    }

    // Participants
    match /participants/{participantId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isManager();
    }

    // SOAP Case Notes
    match /soapCaseNotes/{noteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.resource.data.practitionerId == request.auth.uid || isManager());
    }

    // SOAP Case Notes Drafts (Autosave Resiliency)
    match /soapDrafts/{draftId} {
      allow read, write: if true;
    }

    // Restrictive Practice Protocols
    match /restrictivePracticeProtocols/{protocolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isClinician() || isManager());
    }

    // Restrictive Practice Logs
    match /restrictivePracticeLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isManager();
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isManager();
    }

    // Roster Shifts
    match /rosterShifts/{shiftId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isManager();
    }
  }
}
